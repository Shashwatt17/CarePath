# Final release-candidate configuration. Copy to .env at repository root.
# Use fresh random values; never commit .env. See README and SECURITY before deployment.
POSTGRES_DB=carepath
POSTGRES_USER=carepath
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/carepath
REDIS_HOST=localhost
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8080
# Private local storage, relative to backend/. Maximum 20 MiB (schema ceiling).
STORAGE_ROOT=../.data/documents
VAULT_MAX_BYTES=20971520
# Email currently has an interface only; no external adapter is configured.
# Required for authentication. Generate a local RSA pair; paths are relative to backend/.
JWT_PRIVATE_KEY_PATH=../.data/keys/private.pem
JWT_PUBLIC_KEY_PATH=../.data/keys/public.pem

JWT_ISSUER=https://carepath.local
JWT_AUDIENCE=carepath-api
JWT_ACCESS_SECONDS=300
REFRESH_SECONDS=604800
BCRYPT_COST=12
# Set false ONLY for HTTP localhost development; production defaults to Secure cookies.
AUTH_COOKIE_SECURE=false
# Generate a separate random value >=32 characters; used to HMAC temporary rate-limit keys.
AUTH_RATE_KEY=
AUTH_IP_LIMIT=60
AUTH_ACCOUNT_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Phase 4 local extraction; no LLM or API key required. Install Tesseract + English traineddata.
PROCESSING_TEMP_ROOT=../.data/processing-temp
TESSERACT_COMMAND=tesseract
PROCESSING_WORKER_ENABLED=true
EXTRACTION_TIMEOUT_SECONDS=120
OCR_TIMEOUT_SECONDS=30
EXTRACTION_MAX_PAGES=20
EXTRACTION_MAX_CHARACTERS=250000

# Numerical display tolerance, NOT a clinical threshold (0..0.1).
HISTORY_RELATIVE_TOLERANCE=0.01
# Optional concept UUID=relative tolerance entries separated by semicolons.
HISTORY_CONCEPT_TOLERANCES=

# Optional bounded AI wording; disabled by default. User must also opt in per request.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_RESPONSE_BYTES=32768

# Persistent in-app reminders; external email is not configured.
REMINDERS_ENABLED=true
REMINDER_POLL_MS=30000

# Nearby Care: backend only; Google Places API (New), billing and quota restrictions required
GOOGLE_PLACES_API_KEY=
PLACES_TIMEOUT_SECONDS=8

# Set production on deployed backend; leave blank for local HTTP development.
SPRING_PROFILES_ACTIVE=
# JDBC statement deadline, including lock waits (seconds).
DATABASE_QUERY_TIMEOUT_SECONDS=20

# Phase13 search/activity/onboarding add no external services or secrets.
# Live providers, native services and deployed TLS/browser behavior require separate verification.
